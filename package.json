{
	"name": "ratib-finance-os",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@11.19.0",
	"engines": {
		"node": ">=22 <25"
	},
	"scripts": {
		"dev": "convex dev --start \"vite dev\"",
		"dev:ui": "vite dev",
		"build": "vite build",
		"build:production": "cross-env DEPLOY_ENV=production vite build",
		"preview": "vite preview",
		"convex:dev": "convex dev",
		"convex:env:local": "convex env set --deployment local --from-file .local/generated-auth.env --force",
		"convex:deploy": "convex deploy",
		"privy:smoke": "node scripts/privy-live-smoke.mjs",
		"keys:generate": "node scripts/generate-auth-keys.mjs",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "pnpm test:unit --run",
		"test:all": "pnpm test:unit --run && pnpm test:e2e",
		"test:e2e": "playwright install chromium && playwright test"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^22.20.2",
		"convex-test": "^0.0.57",
		"cross-env": "^10.1.0",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"jsdom": "^30.0.1",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"shadcn-svelte": "^1.6.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@lucide/svelte": "^1.44.0",
		"@privy-io/js-sdk-core": "0.75.0",
		"@privy-io/node": "0.34.0",
		"clsx": "^2.1.1",
		"convex": "^1.45.0",
		"convex-svelte": "^0.14.0",
		"jose": "^6.2.12",
		"svix": "^2.4.0",
		"tailwind-merge": "^3.6.0",
		"viem": "^2.56.0",
		"zod": "^4.6.2"
	}
}
